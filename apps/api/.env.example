# Pooled connection for the running API. On a single Postgres this matches DIRECT_URL.
# On Neon this is the pooler host. The app does not require this file to boot.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/property_control?schema=public
# Direct connection used by Prisma migrations. On Neon this is the non-pooler host.
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/property_control?schema=public
PORT=3000

# Base64 of at least 32 random bytes. No value is stored here.
# Boot refuses to listen when this is missing, empty, or too short.
SERVER_SECRET=

# ES256 P-256 key pair. PEM, with newlines as \n. No real keys are stored here.
# Boot refuses a key that is not P-256 or a private key that does not match the public key.
AUTH_JWT_PRIVATE_KEY=
AUTH_JWT_PUBLIC_KEY=
AUTH_JWT_KID=primary
# Optional previous public key so rotation does not sign everyone out.
AUTH_JWT_PREVIOUS_PUBLIC_KEY=
AUTH_JWT_PREVIOUS_KID=

# Resend. Production fails closed with 503 auth.unavailable when the key is empty.
# The default From is Resend's test sender. No real API key is stored here.
RESEND_API_KEY=
AUTH_EMAIL_FROM=DueRecord <onboarding@resend.dev>

# Login code limits. Defaults: 5 emails per hour, 20 requests per hour per IP.
AUTH_CODE_EMAIL_LIMIT=5
AUTH_CODE_IP_LIMIT=20
AUTH_VERIFY_IP_LIMIT=20

# Required before the process listens. Not read by the test app.
AVISO_VERSION=2026-10-21
AVISO_URL=https://example.com/aviso

# Optional S3-compatible object storage. No provider SDK. Upload routes stay 501.
# OBJECT_STORAGE_ENDPOINT=https://example.r2.cloudflarestorage.com
# OBJECT_STORAGE_REGION=auto
# OBJECT_STORAGE_BUCKET=evidence
# OBJECT_STORAGE_ACCESS_KEY_ID=
# OBJECT_STORAGE_SECRET_ACCESS_KEY=
# OBJECT_STORAGE_FORCE_PATH_STYLE=true

# OCR stub. Off unless the value is 1, true, yes, or on. Anything else is off.
OCR_STUB_ENABLED=

# Comma-separated browser origins. Empty means no cross-origin access.
# A "*" entry is ignored and is never reflected.
CORS_ORIGINS=

# In-memory OCR jobs. Expired jobs can be dropped. Unexpired suggested jobs are not evicted.
# OCR_JOBS_MAX is per property. OCR_JOBS_GLOBAL_MAX is the ceiling across properties.
OCR_JOBS_MAX=50
OCR_JOBS_GLOBAL_MAX=1000
OCR_JOB_TTL_MS=900000
