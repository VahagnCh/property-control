{
  "name": "@property-control/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Property Control API. Records obligations and payments the user already made.",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node --import tsx src/main.ts",
    "start:dev": "node --import tsx --watch src/main.ts",
    "start:prod": "node dist/main.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prisma:validate": "prisma validate",
    "prisma:generate": "prisma generate"
  },
  "dependencies": {
    "@nestjs/common": "^12.1.2",
    "@nestjs/core": "^12.1.2",
    "@nestjs/platform-express": "^12.1.2",
    "@prisma/client": "^6.19.3",
    "dotenv": "^16.6.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/testing": "^12.1.2",
    "@types/express": "^5.0.3",
    "@types/node": "^22.19.0",
    "@types/supertest": "^6.0.3",
    "prisma": "^6.19.3",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vitest": "^5.0.3"
  }
}
